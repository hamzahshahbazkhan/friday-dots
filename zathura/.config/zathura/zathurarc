# ==================================================
# ZATHURA CONFIG – SEPIA DARK MODE (CLEAN & WORKING)
# ==================================================

# -------------------
# Font
# -------------------
set font "ttf-hack 10"

# -------------------
# Base Colors (Gruvbox Sepia)
# -------------------
set default-bg "#32302f"
set default-fg "#d4be98"

# Completion menu
set completion-bg "#32302f"
set completion-fg "#d4be98"
set completion-group-bg "#252423"
set completion-group-fg "#d4be98"
set completion-highlight-bg "#d4be98"
set completion-highlight-fg "#32302f"

# Input bar
set inputbar-bg "#32302f"
set inputbar-fg "#a9b665"

# Status bar
set statusbar-bg "#252423"
set statusbar-fg "#d4be98"
set statusbar-h-padding 10
set statusbar-v-padding 5

# Notifications
set notification-bg "#a9b665"
set notification-fg "#252423"
set notification-error-bg "#ea6962"
set notification-error-fg "#252423"
set notification-warning-bg "#d8a657"
set notification-warning-fg "#252423"

# -------------------
# Search & Highlight
# -------------------
set incremental-search true
set highlight-color rgba(137,180,130,0.5)
set highlight-active-color rgba(231,138,78,0.5)
set highlight-fg rgba(37,36,35,1)

# -------------------
# PDF Recolor – SEPIA MODE
# -------------------
set recolor true
set recolor-lightcolor "#ddc7a1"   # Sepia paper
set recolor-darkcolor  "#252423"   # Ink
set recolor-keephue false         # IMPORTANT
set recolor-reverse-video false   # IMPORTANT

# -------------------
# Workflow & Navigation
# -------------------
set page-padding 10
set show-directories true
set show-hidden true
set show-recent 5
set guioptions vs
set smooth-scroll true

# -------------------
# System Integration
# -------------------
set selection-clipboard clipboard
set database sqlite
set window-title-basename true
set autosave-interval 300

# -------------------
# Keybindings
# -------------------

# Toggle Sepia <-> Original
map <C-s> recolor

# Vim-style toggle (optional)
map z recolor

# Recolor presets: S = sepia paper, D = dark mode (both force recolor on)
map S feedkeys ":set recolor-lightcolor #ddc7a1<Return>:set recolor-darkcolor #252423<Return>:set recolor-keephue false<Return>:set recolor-reverse-video false<Return>:set recolor true<Return>"
map D feedkeys ":set recolor-lightcolor #282828<Return>:set recolor-darkcolor #d4cfc4<Return>:set recolor-keephue true<Return>:set recolor-reverse-video false<Return>:set recolor true<Return>"

# Smooth navigation (optional but nice)
map j scroll down
map k scroll up
map h scroll left
map l scroll right

# Page navigation
map J navigate next
map K navigate previous

# Palette switches with the active desktop theme.
include ../themes/current/zathurarc
